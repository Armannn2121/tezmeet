# Көшіріңіз: cp .env.example .env   (.env репозиторийге түспейді)
# Gemini API кілті — https://aistudio.google.com/apikey (тегін тариф жеткілікті).
# Бос қалдырсаңыз: мағыналық ұқсастық TF-IDF арқылы, алғашқы фраза шаблон арқылы — бәрі жұмыс істейді.
GEMINI_API_KEY=

# Міндетті емес
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# PORT=8080
